# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
QUALIFICATION_MODEL=claude-haiku-4-5-20251001
SCORING_MODEL=claude-sonnet-4-6

# --- Database (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- Calendar (Cal.com) ---
CALCOM_API_KEY=cal_live_...
CALCOM_EVENT_TYPE_ID=123456
CALCOM_API_BASE=https://api.cal.com/v2

# --- Messaging (Twilio) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_FROM_SMS=+1415XXXXXXX
BUSINESS_OWNER_PHONE=+91XXXXXXXXXX

# --- App ---
# When true, Cal.com and Twilio calls are mocked/logged instead of firing for
# real. Flip to false only once you've plugged in real API keys above.
DEMO_MODE=true
